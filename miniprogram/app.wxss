page{background:#f7f6f3;color:#37352f;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx}.page{padding:36rpx}.title{font-size:46rpx;font-weight:700;line-height:1.4;margin-bottom:16rpx}.sub{color:#69665f;line-height:1.7;font-size:25rpx}.block{padding:30rpx;border:1rpx solid #e5e7eb;border-radius:12rpx;margin:24rpx 0;background:#fff}.block-title{font-size:32rpx;font-weight:600;margin-bottom:16rpx}.nav{display:flex;flex-wrap:wrap;gap:12rpx;margin:28rpx 0}button{background:transparent;color:#37352f;border:1rpx solid #deded9;border-radius:10rpx;font-size:28rpx;margin:0;padding:0 24rpx}button::after{border:none}.primary{background:#37352f;color:white;margin-top:28rpx}label{display:block;margin:26rpx 0 12rpx;font-weight:500}input,textarea,.picker{box-sizing:border-box;width:100%;background:#fff;border:1rpx solid #e5e7eb;border-radius:8rpx;padding:20rpx;height:auto;min-height:80rpx}textarea{min-height:160rpx}.error{padding:18rpx;color:#a13630;background:#fff4f2;margin:16rpx 0;line-height:1.6}.photo{width:180rpx;height:180rpx;margin-top:20rpx}.event{padding:20rpx 0;border-bottom:1rpx solid #e5e7eb}.row{margin:14rpx 0;line-height:1.6}

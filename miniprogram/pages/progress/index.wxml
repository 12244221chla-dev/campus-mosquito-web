<view class="page"><view class="title">进度查询</view><input value="{{code}}" bindinput="input" placeholder="输入本人事项编号"/><button class="primary" bindtap="query">查询</button><view class="error" wx:if="{{error}}">{{error}}</view><view class="block" wx:if="{{matter}}"><view class="block-title">{{matter.title}}</view><view class="row">{{matter.code}}</view><view class="row">状态：{{matter.statusName}}</view><view class="row">进度：{{matter.progress}}%</view><view class="row">时限：{{matter.dueAt}}</view><view class="event" wx:for="{{matter.timeline}}" wx:key="index"><view>{{item.kindName}} · {{item.at}}</view><view class="sub">{{item.note}}</view></view></view><view class="block-title">本机提交记录</view><view class="block" wx:for="{{receipts}}" wx:key="*this" bindtap="select" data-code="{{item}}">{{item}}</view></view>

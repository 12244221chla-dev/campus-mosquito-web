<view class="page"><view class="title">账号</view><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{session.authenticated}}"><view class="block">当前账号：{{session.name}}</view><button wx:if="{{session.canManage}}" bindtap="manager">复制网页管理工作台地址</button><button bindtap="logout">退出登录</button></view><view wx:else><label>身份</label><picker range="{{roles}}" value="{{roleIndex}}" bindchange="role"><view class="picker">{{roles[roleIndex]}}</view></picker><label>{{roleIndex===0?'学号':roleIndex===1?'手机号':'管理员用户名'}}</label><input data-key="identifier" bindinput="input"/><label wx:if="{{register}}">姓名</label><input wx:if="{{register}}" data-key="name" bindinput="input"/><label>密码</label><input password data-key="password" bindinput="input"/><label wx:if="{{register}}">确认密码</label><input wx:if="{{register}}" password data-key="confirm" bindinput="input"/><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{register?'注册':'登录'}}</button><button wx:if="{{roleIndex!==2}}" bindtap="toggle">{{register?'返回登录':'注册账号'}}</button><view class="sub">教师注册不自动获得管理权限。尚未接入学校认证及短信验证。</view></view></view>

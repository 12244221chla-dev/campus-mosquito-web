<view class="page"><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{scene}}"><view class="title">{{scene.name}}</view><view class="sub">{{scene.summary}}</view><label>事项标题 *</label><input maxlength="120" data-key="title" bindinput="input" placeholder="说明本次事项"/><label>发生地点 *</label><input maxlength="100" data-key="location" bindinput="input" placeholder="楼栋、房间或区域"/><view wx:for="{{fields}}" wx:key="key"><label>{{item.label}}{{item.required?' *':''}}</label><picker wx:if="{{item.type==='select'}}" range="{{item.options}}" data-index="{{index}}" bindchange="pick"><view class="picker">{{values[item.key]||'请选择'}}</view></picker><textarea wx:elif="{{item.type==='textarea'}}" maxlength="200" data-key="{{item.key}}" bindinput="input"/><input wx:else type="{{item.type==='number'?'digit':'text'}}" maxlength="200" data-key="{{item.key}}" bindinput="input" placeholder="{{item.placeholder}}"/></view><label>补充说明</label><textarea maxlength="1000" data-key="detail" bindinput="input"/><label>现场照片{{scene.requiresPhoto?'（必填）':'（选填）'}}</label><button bindtap="photo">选择照片</button><image class="photo" wx:if="{{photo}}" src="{{photo}}" mode="aspectFill"/><view class="sub">最多1张、5MB，勿拍摄人脸或证件。</view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交报备</button></view></view>
